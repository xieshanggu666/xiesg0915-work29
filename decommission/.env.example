# HTTP 监听地址
HTTP_ADDR=:8080

# PostgreSQL（留空则使用内存存储，仅用于演示/测试）
DATABASE_URL=postgres://decommission:decommission@localhost:5432/decommission?sslmode=disable

# MinIO / S3（留空则报告写本地 REPORT_DIR）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erasure-reports
MINIO_REGION=us-east-1
MINIO_USE_TLS=false
REPORT_DIR=./reports

# 并发擦除的磁盘数
WORKERS=4
# 单次写/读块大小、断点间隔
CHUNK_BYTES=4194304
CHECKPOINT_EVERY_BYTES=67108864
# 心跳超过该秒数的运行中任务视为僵死（重启时另有启动即回收机制）
STALE_AFTER_SEC=120
# 允许擦除的设备/镜像路径前缀（逗号分隔，安全护栏，默认仅 /dev/）
DEVICE_PATH_PREFIX=/dev/,/var/lib/erasure/disks/

# 附带演示数据（仅内存存储模式生效）
DEMO=false
